{
  "task_id": "dr_rfp_second_year",
  "skill_id": "ms_revenue_for_period",
  "title": "Revenue in the second year",
  "kind": "drill",
  "node_ids": [
    "ind_as_115.step_5.measuring_progress"
  ],
  "company": {
    "company_name": "Kalmira Techworks Private Limited",
    "company_short": "Kalmira",
    "company_city": "Pune",
    "company_business": "IT implementation and managed services for mid-size Indian businesses"
  },
  "narrative_template": "Kalmira's fixed-price contract with {customer} is for ₹{price}, with total expected cost ₹{total_cost} (unchanged since the start). Costs incurred were ₹{costs_last_year} by 31 March 2025 and ₹{costs_to_date} by 31 March 2026, in total. How much revenue does Kalmira recognise in FY 2025-26?\n\nRound amounts to the nearest rupee and percentages to one decimal place. All names are fictional.",
  "params": {
    "customer": {
      "type": "name",
      "choices": [
        "Veloria Retail Ltd",
        "Zenara Finance Ltd",
        "Korvani Freight Ltd"
      ]
    },
    "price": {
      "type": "money",
      "min": "1000000",
      "max": "100000000",
      "step": "100000"
    },
    "total_cost": {
      "type": "money",
      "min": "600000",
      "max": "90000000",
      "step": "10000"
    },
    "costs_last_year": {
      "type": "money",
      "min": "100000",
      "max": "80000000",
      "step": "10000"
    },
    "costs_to_date": {
      "type": "money",
      "min": "100000",
      "max": "85000000",
      "step": "10000"
    }
  },
  "constraints": [
    "total_cost <= price * 0.9",
    "total_cost >= price * 0.6",
    "costs_last_year >= total_cost * 0.1",
    "costs_to_date >= costs_last_year + total_cost * 0.1",
    "costs_to_date <= total_cost * 0.9"
  ],
  "documents": [],
  "calculator": "formula",
  "answer_fields": [
    "revenue_this_year"
  ],
  "rubric": [
    {
      "id": "a1",
      "text": "This year's revenue = cumulative revenue less last year's.",
      "weight": 1.0,
      "node_id": "ind_as_115.step_5.measuring_progress",
      "passage_ids": [
        "IndAS115.para.39"
      ],
      "required": true,
      "check": {
        "type": "numeric",
        "field": "revenue_this_year",
        "tolerance": "0.5%|1000"
      }
    }
  ],
  "planted_discrepancies": [],
  "model_answer_template": "₹{revenue_this_year}",
  "pass_threshold": 1.0,
  "template_version": "0.1.0",
  "options": [],
  "answer_exprs": {
    "revenue_this_year": "price * (costs_to_date - costs_last_year) / total_cost"
  },
  "explanation": "Revenue this year = cumulative revenue to date - revenue recognised last year = ₹{revenue_this_year}.",
  "mistakes": [
    {
      "expr": "price * costs_to_date / total_cost",
      "feedback": "That is cumulative revenue on the contract. This year's revenue is cumulative revenue less what was recognised in earlier years.",
      "field": "revenue_this_year"
    }
  ],
  "example_params": {
    "customer": "Veloria Retail Ltd",
    "price": "12000000",
    "total_cost": "9000000",
    "costs_last_year": "2700000",
    "costs_to_date": "6300000"
  }
}
