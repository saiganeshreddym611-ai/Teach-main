{
  "task_id": "dr_ctc_revised_estimate",
  "skill_id": "ms_cost_to_cost_progress",
  "title": "Progress after the estimate changes",
  "kind": "drill",
  "node_ids": [
    "ind_as_115.step_5.measuring_progress"
  ],
  "company": {
    "company_name": "Kalmira Techworks Private Limited",
    "company_short": "Kalmira",
    "company_city": "Pune",
    "company_business": "IT implementation and managed services for mid-size Indian businesses"
  },
  "narrative_template": "Kalmira's fixed-price contract with {customer} is for ₹{price}. At the start, total cost was expected to be ₹{original_total_cost}. By 31 March 2026 the estimate has risen to ₹{revised_total_cost}, and costs incurred to date are ₹{costs_to_date}. What is the measure of progress at 31 March 2026?\n\nRound amounts to the nearest rupee and percentages to one decimal place. All names are fictional.",
  "params": {
    "customer": {
      "type": "name",
      "choices": [
        "Veloria Retail Ltd",
        "Zenara Finance Ltd",
        "Korvani Freight Ltd"
      ]
    },
    "price": {
      "type": "money",
      "min": "1000000",
      "max": "100000000",
      "step": "100000"
    },
    "original_total_cost": {
      "type": "money",
      "min": "600000",
      "max": "90000000",
      "step": "10000"
    },
    "revised_total_cost": {
      "type": "money",
      "min": "600000",
      "max": "95000000",
      "step": "10000"
    },
    "costs_to_date": {
      "type": "money",
      "min": "100000",
      "max": "80000000",
      "step": "10000"
    }
  },
  "constraints": [
    "original_total_cost >= price * 0.6",
    "revised_total_cost >= original_total_cost * 1.1",
    "revised_total_cost <= price * 0.95",
    "costs_to_date >= revised_total_cost * 0.2",
    "costs_to_date <= revised_total_cost * 0.8"
  ],
  "documents": [],
  "calculator": "formula",
  "answer_fields": [
    "progress_percent"
  ],
  "rubric": [
    {
      "id": "a1",
      "text": "Progress uses the revised total cost estimate.",
      "weight": 1.0,
      "node_id": "ind_as_115.step_5.measuring_progress",
      "passage_ids": [
        "IndAS115.para.39",
        "IndAS115.para.43"
      ],
      "required": true,
      "check": {
        "type": "numeric",
        "field": "progress_percent",
        "tolerance": "0.1"
      }
    }
  ],
  "planted_discrepancies": [],
  "model_answer_template": "{progress_percent}%",
  "pass_threshold": 1.0,
  "template_version": "0.1.0",
  "options": [],
  "answer_exprs": {
    "progress_percent": "costs_to_date / revised_total_cost * 100"
  },
  "explanation": "Use the latest estimate of total cost: the measure of progress is updated as circumstances change (para 43). Progress = {progress_percent}%.",
  "mistakes": [
    {
      "expr": "costs_to_date / original_total_cost * 100",
      "feedback": "You used the original estimate. Progress is remeasured at each reporting date with the latest estimate (para 43).",
      "field": "progress_percent"
    }
  ],
  "example_params": {
    "customer": "Veloria Retail Ltd",
    "price": "9000000",
    "original_total_cost": "6000000",
    "revised_total_cost": "7500000",
    "costs_to_date": "3000000"
  }
}
